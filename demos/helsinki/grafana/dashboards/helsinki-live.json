          "entityType": "AirQualityObserved",
          "queryType": "geo",
          "entityName": "name"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "ngsild-grafana-datasource",
            "uid": "${ds}"
          },
          "entityType": "Vehicle",
          "queryType": "geo",
