      },
      "description": "Central Helsinki from the NGSI-LD broker: parks, squares and roads (OpenStreetMap shapes), FMI air quality stations, the next events and live HSL trams with their trails. Hover a marker for all its values; observedAt is when the station or tram last reported. Shapes: Geo query, Location: Shape. Stations, events, trams: Geo query, Location: Point. Trails: Geo query, Location: Trail (the trams' positions in the time range from the temporal API)."
    },
    {
      "id": 8,
      "type": "table",
      "title": "Next events (Linked Events; each entity expires when the event ends)",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 15
      },
      "datasource": {
        "type": "ngsild-grafana-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "ngsild-grafana-datasource",
            "uid": "${ds}"
          },
          "queryType": "entity",
          "format": "table",
          "entityType": "Event",
          "attributes": [
            "name",
            "startDate",
            "venue",
            "category"
          ],
          "ngsildOptions": [
            "sysAttrs"
          ],
          "limit": 100
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "startDate",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "startDate"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "id": true,
              "type": true
            },
            "indexByName": {
              "startDate": 0,
              "expiresAt": 1,
              "name": 2,
              "venue": 3,
              "category": 4
            },
            "renameByName": {
              "startDate": "Starts",
              "expiresAt": "Ends (expiresAt)",
              "name": "Event",
              "venue": "Venue",
              "category": "Category"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Starts"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ends (expiresAt)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "The next 24 hours of events in central Helsinki from Linked Events, refreshed every 15 minutes. Current value query as a table, with system attributes. Each Event's expiresAt is its end time, so the broker drops it once it is over."
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Air quality index now (FMI, measured)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "ngsild-grafana-datasource",
        "uid": "${ds}"
