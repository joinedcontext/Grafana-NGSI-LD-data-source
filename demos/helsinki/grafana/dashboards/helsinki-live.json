{
  "uid": "ngsild-helsinki-live",
  "title": "NGSI-LD Helsinki live",
  "description": "Live open data of Helsinki through the NGSI-LD data source: measured air quality (FMI), trams (HSL), events (Linked Events), places (OpenStreetMap).",
  "tags": [
    "ngsi-ld",
    "sample",
    "helsinki"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "ngsild-grafana-datasource",
        "current": {
          "text": "NGSI-LD",
          "value": "ngsild_1"
        }
      }
    ]
  },
  "panels": [
