      "id": 1,
      "type": "geomap",
      "title": "Central Helsinki: places, air quality, events and live trams with their trails",
      "datasource": {
        "type": "ngsild-grafana-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 15
