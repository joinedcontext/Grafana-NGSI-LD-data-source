      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "ngsild-grafana-datasource",
            "uid": "${ds}"
          },
          "queryType": "entity",
          "entityType": "AirQualityObserved",
          "attributes": [
            "airQualityIndex"
          ],
          "entityName": "name",
          "namePattern": "entity_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5,
          "decimals": 0,
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Good",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "Satisfactory",
                  "color": "yellow",
                  "index": 1
                },
                "3": {
                  "text": "Fair",
                  "color": "orange",
                  "index": 2
                },
                "4": {
                  "text": "Poor",
                  "color": "red",
                  "index": 3
                },
                "5": {
                  "text": "Very poor",
                  "color": "purple",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              },
              {
                "color": "purple",
                "value": 5
              }
            ]
          },
          "links": [
            {
              "title": "${__field.displayName}: measured ${__value.time:date:D.M.YYYY HH:mm}",
              "url": "/d/ngsild-helsinki-live?viewPanel=12&${__url_time_range}"
            },
            {
              "title": "PM2.5 of the last 48 h",
              "url": "/d/ngsild-helsinki-live?viewPanel=10&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Latest air quality index of each FMI station, measured hourly: 1 good, 2 satisfactory, 3 fair, 4 poor, 5 very poor. Click a bar to see when the station measured it, and to open its history."
    },
    {
      "id": 10,
