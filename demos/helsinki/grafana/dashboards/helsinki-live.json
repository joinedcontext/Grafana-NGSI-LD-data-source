        },
        {
          "refId": "F",
          "datasource": {
            "type": "ngsild-grafana-datasource",
            "uid": "${ds}"
          },
          "queryType": "geo",
          "geoLocation": "trail",
          "entityType": "Vehicle",
          "entityName": "name"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "ngsild-grafana-datasource",
            "uid": "${ds}"
