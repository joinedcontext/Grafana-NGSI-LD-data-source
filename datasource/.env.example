# Copy to .env to point the stack at another broker. Without .env it uses the bundled Antares.
# BROKER_URL=https://broker.example.org
# CONTEXT_URL=https://example.org/context.jsonld
# TENANT=
# OAuth2 client credentials (Keycloak etc.):
# AUTH_TYPE=oauth
# TOKEN_URL=https://keycloak.example.org/realms/x/protocol/openid-connect/token
# CLIENT_ID=
# CLIENT_SECRET=
# Host ports and versions:
# GRAFANA_PORT=3000
# BROKER_PORT=9090
# GRAFANA_VERSION=12.3.0
# ANTARES_VERSION=latest
