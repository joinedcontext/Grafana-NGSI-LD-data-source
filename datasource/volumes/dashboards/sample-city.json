{
 "uid": "ngsild-sample-city",
 "title": "NGSI-LD sample city",
 "description": "Every query type of the NGSI-LD data source on the seed dataset (datasource/seed/seed.mjs).",
 "tags": [
  "ngsi-ld",
  "sample"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-2d",
  "to": "now"
 },
 "refresh": "",
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "ngsild-grafana-datasource",
    "current": {
     "text": "NGSI-LD",
     "value": "ngsild_1"
    }
   },
   {
    "name": "station",
    "label": "Station",
    "type": "query",
    "datasource": {
     "type": "ngsild-grafana-datasource",
     "uid": "${ds}"
    },
    "query": "entities(AirQualityObserved, name)",
    "definition": "entities(AirQualityObserved, name)",
    "multi": true,
    "includeAll": true,
    "allValue": "",
    "refresh": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "PM10 and PM2.5 (temporal)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "temporal",
     "entityType": "AirQualityObserved",
     "entityId": "$station",
     "entityName": "name",
     "lang": "en",
     "attributes": [
      "pm10",
      "pm25"
     ]
    }
   ],
   "description": "Hourly PM10 and PM2.5 of the stations picked in Station, over the time range. Temporal query; the seed writes 48 hours of history."
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "NO2, 6-hour average and maximum (temporal aggregation)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "temporal",
     "entityType": "AirQualityObserved",
     "entityId": "$station",
     "entityName": "name",
     "lang": "en",
     "attributes": [
      "no2"
     ],
     "aggrMethod": "avg,max",
     "aggrPeriodDuration": "PT6H"
    }
   ],
   "description": "NO2 average and maximum per 6-hour period of the picked stations, computed by the broker (temporal aggregation over PT6H)."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Air quality index (current value)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "entity",
     "entityType": "AirQualityObserved",
     "entityId": "$station",
     "entityName": "name",
     "lang": "en",
     "attributes": [
      "airQualityIndex"
     ],
     "namePattern": "entity_name"
    }
   ],
   "description": "Current air quality index of each picked station: current value query, one value per entity."
  },
  {
   "id": 4,
   "type": "table",
   "title": "Stations (current values)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 8,
    "y": 9,
    "w": 16,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "entity",
     "format": "table",
     "entityType": "AirQualityObserved",
     "entityId": "$station",
     "entityName": "name",
     "lang": "en",
     "attributes": [
      "name",
      "pm10",
      "temperature",
      "isOnline"
     ]
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "type": true
      },
      "renameByName": {
       "id": "entity id"
      },
      "indexByName": {
       "id": 0,
       "type": 1,
       "name": 2,
       "pm10": 3,
       "temperature": 4,
       "isOnline": 5,
       "observedAt": 6
      }
     }
    }
   ],
   "description": "Current values as a table, one row per station, columns in the query's attribute order. observedAt is the time of the station's newest reading."
  },
  {
   "id": 5,
   "type": "geomap",
   "title": "Locations (points, lines, polygons)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "geo",
     "entityType": "AirQualityObserved,Building,Road,Zone,Park",
     "entityName": "name",
     "lang": "en",
     "geoLocation": "shape"
    }
   ],
   "options": {
    "view": {
     "id": "coords",
     "lat": 60.1755,
     "lon": 24.944,
     "zoom": 13.6
    },
    "controls": {
     "showZoom": true,
     "mouseWheelZoom": true
    },
    "basemap": {
     "type": "osm-standard",
     "name": "OpenStreetMap"
    },
    "layers": [
     {
      "type": "markers",
      "name": "Shapes",
      "tooltip": true,
      "location": {
       "mode": "auto"
      },
      "config": {
       "showLegend": false,
       "style": {
        "color": {
         "fixed": "orange"
        },
        "opacity": 0.9,
        "size": {
         "fixed": 10
        },
        "symbol": {
         "mode": "fixed",
         "fixed": "img/icons/marker/circle.svg"
        },
        "lineWidth": 3
       }
      }
     },
     {
      "type": "markers",
      "name": "Labels",
      "tooltip": false,
      "location": {
       "mode": "auto"
      },
      "config": {
       "showLegend": false,
       "style": {
        "color": {
         "fixed": "orange"
        },
        "opacity": 0.9,
        "size": {
         "fixed": 10
        },
        "symbol": {
         "mode": "fixed",
         "fixed": ""
        },
        "text": {
         "mode": "field",
         "field": "name",
         "fixed": ""
        },
        "textConfig": {
         "fontSize": 12,
         "offsetY": -16,
         "textAlign": "center",
         "textBaseline": "bottom"
        }
       }
      }
     }
    ],
    "tooltip": {
     "mode": "details"
    }
   },
   "description": "Every located entity of the seed: stations as points, the road as a line, zones, parks and buildings as outlines. Geo query, Location: Shape."
  },
  {
   "id": 6,
   "type": "nodeGraph",
   "title": "Relationships (node graph)",
   "datasource": {
    "type": "ngsild-grafana-datasource",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "ngsild-grafana-datasource",
      "uid": "${ds}"
     },
     "queryType": "nodegraph",
     "entityType": "AirQualityObserved",
     "entityName": "name",
     "lang": "en",
     "primaryNodeAttributes": {
      "": [
       "pm10",
       "batteryLevel",
       "floorsAboveGround"
      ]
     }
    }
   ],
   "description": "Air quality stations and the entities their relationships point to, with pm10, battery level and floors as node values. Node graph query."
  }
 ]
}